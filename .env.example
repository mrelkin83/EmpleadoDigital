# === Base de datos (PostgreSQL — ver docker-compose.yml) ===
DATABASE_URL=postgres://empleado:empleado@localhost:5433/empleado_digital

# === API ===
API_PORT=3001
API_HOST=0.0.0.0

# === Meta / Instagram (APIs oficiales) ===
# Se obtienen creando una app en https://developers.facebook.com
META_APP_SECRET=
META_VERIFY_TOKEN=
# --- Opción A (recomendada): OAuth Business Login ---
# App de Instagram en developers.facebook.com → producto "Instagram API with Instagram Login"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe coincidir EXACTAMENTE con la Redirect URI configurada en la app de Meta (HTTPS en prod)
OAUTH_REDIRECT_URI=https://localhost:3001/auth/instagram/callback
# Clave de cifrado de tokens en reposo (32 bytes hex). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# URL del dashboard al que se redirige tras conectar
WEB_BASE_URL=http://localhost:3000

# --- Opción B (solo desarrollo): token manual ---
# Token de acceso de la cuenta profesional de Instagram. NUNCA guardar contraseñas.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# === Proveedores de IA (opcionales: sin claves, el sistema usa MockProvider en dev) ===
ANTHROPIC_API_KEY=
# Google AI Studio (https://aistudio.google.com/apikey): texto de respaldo + generación de imágenes/voz
GEMINI_API_KEY=
# Pexels (https://www.pexels.com/api/, gratis): clips de stock para el "video económico" (voz + B-roll)
PEXELS_API_KEY=
OPENAI_API_KEY=

# === Control de costes ===
AI_DAILY_BUDGET_USD=5

# === Entorno ===
NODE_ENV=development
LOG_LEVEL=info
