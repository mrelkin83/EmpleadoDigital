{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@empleado/shared": ["packages/shared/src/index.ts"],
      "@empleado/ai-core": ["packages/ai-core/src/index.ts"],
      "@empleado/ai-providers": ["packages/ai-providers/src/index.ts"],
      "@empleado/social": ["packages/social/src/index.ts"],
      "@empleado/brand": ["packages/brand/src/index.ts"],
      "@empleado/content": ["packages/content/src/index.ts"],
      "@empleado/skills": ["packages/skills/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/api/src/**/*.ts",
    "apps/api/test/**/*.ts",
    "apps/worker/src/**/*.ts",
    "db/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "apps/web"]
}
